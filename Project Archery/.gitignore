# .gitignore du projet Unity, d'après https://github.com/github/gitignore/blob/main/Unity.gitignore
# Les chemins qui commencent par « / » partent de ce dossier (la racine du projet Unity).

# Dossiers générés par Unity (recréés à l'ouverture du projet)
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.log

# Sauvegardes automatiques de Blender
*.blend1
*.blend1.meta

# Fichiers de solution et de projet générés pour l'IDE (Unity les recrée)
.vs/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Métadonnées de fichiers générés
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Rapports de plantage
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Builds et paquets exportés
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Scènes générées par les tests
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Nature Kit de Kenney : seuls les modèles FBX servent. Les autres formats (les mêmes modèles)
# et les 1 600 images d'aperçu alourdiraient le dépôt de près de 40 Mo.
/[Aa]ssets/kenney_nature-kit/Isometric/
/[Aa]ssets/kenney_nature-kit/Isometric.meta
/[Aa]ssets/kenney_nature-kit/Side/
/[Aa]ssets/kenney_nature-kit/Side.meta
/[Aa]ssets/kenney_nature-kit/Models/DAE format/
/[Aa]ssets/kenney_nature-kit/Models/DAE format.meta
/[Aa]ssets/kenney_nature-kit/Models/GLTF format/
/[Aa]ssets/kenney_nature-kit/Models/GLTF format.meta
/[Aa]ssets/kenney_nature-kit/Models/OBJ format/
/[Aa]ssets/kenney_nature-kit/Models/OBJ format.meta
/[Aa]ssets/kenney_nature-kit/Models/STL format/
/[Aa]ssets/kenney_nature-kit/Models/STL format.meta

# Castle Kit de Kenney : seuls les FBX (avec leur dossier Textures) et les variantes de couleurs servent.
/[Aa]ssets/kenney_castle-kit/Previews/
/[Aa]ssets/kenney_castle-kit/Previews.meta
/[Aa]ssets/kenney_castle-kit/Models/GLB format/
/[Aa]ssets/kenney_castle-kit/Models/GLB format.meta
/[Aa]ssets/kenney_castle-kit/Models/OBJ format/
/[Aa]ssets/kenney_castle-kit/Models/OBJ format.meta

# Archives téléchargées (packs d'assets) laissées à la racine du projet Unity
/*.zip
