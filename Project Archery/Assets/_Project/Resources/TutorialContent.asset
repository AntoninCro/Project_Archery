%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec8d01e5014e49369fd4695324f9df2b, type: 3}
  m_Name: TutorialContent
  m_EditorClassIdentifier: Archery.Runtime::Archery.Menus.TutorialContent
  sections:
  - title: Tir
    videoPrefix: Tir
    icon: {fileID: 21300000, guid: f5451cef9ad247c4960997e915323f22, type: 3}
    windows:
    - title: "Tirer \xE0 l'arc"
      text: "Prends l'arc avec la poign\xE9e. Attrape une fl\xE8che au-dessus de
        ton \xE9paule et pose-la sur la corde : tends-la, puis l\xE2che."
    - title: L'anneau et les points faibles
      text: "\xC0 pleine tension, un anneau appara\xEEt : l\xE2che quand le cercle
        passe dans le vert (un \xAB ding \xBB te pr\xE9vient). La t\xEAte compte
        double, la gemme des boss triple."
    - title: "La grenade \xE0 fl\xE8ches"
      text: "Porte une main vide \xE0 ta hanche, comme pour fouiller ta poche, et
        serre la poign\xE9e : une grenade sort. Lance-la : elle \xE9clate au premier
        contact en une gerbe de fl\xE8ches. Ta montre affiche sa recharge."
  - title: "D\xE9placement"
    videoPrefix: Deplacement
    icon: {fileID: 21300000, guid: 800b1b0233fa4bd58124bbb5bba421b2, type: 3}
    windows:
    - title: Marcher et tourner
      text: "Le joystick gauche te fait marcher l\xE0 o\xF9 tu regardes. Le joystick
        droit te tourne par crans (d\xE9sactivable dans les param\xE8tres)."
    - title: Courir et sauter
      text: "En marchant, balance les bras pour courir jusqu'\xE0 trois fois plus
        vite. L\xE8ve les deux bras d'un coup pour sauter."
    - title: Glisser
      text: 'En pleine course, appuie sur A ou X : tu glisses loin, les mains libres
        pour tirer.'
    - title: Monter sur la tour
      text: "Reste une seconde sur la bande lumineuse au pied de la tour pour monter.
        Pour redescendre, saute. Le bouton \xAB Tour \xBB de ta montre te ram\xE8ne
        aussi en haut."
  - title: Vagues
    videoPrefix: Vagues
    icon: {fileID: 21300000, guid: b070f6fe023c42f98a2c2fa898dad3e9, type: 3}
    windows:
    - title: Lancer une vague
      text: "Tire dans le gong pour lancer la vague : d'abord une accalmie, puis
        les ennemis arrivent de plus en plus vite. \xC0 la fin du chrono, le boss
        arrive."
    - title: Ta vie et la tour
      text: "\xC0 z\xE9ro PV, la partie est perdue. Si la tour tombe, tu gagnes deux
        fois moins d'or : r\xE9pare-la \xE0 la boutique. Les barricades retiennent
        les ennemis au sol."
    - title: Les boss
      text: "Chaque vague se termine par un boss : vise sa gemme, son point faible.
        Deux coups de gong pendant le chrono le font venir plus t\xF4t, pour plus
        d'or."
    - title: La montre
      text: 'Regarde ton poignet : tes PV, la vague, le chrono, tes plans de construction
        et tes bonus en cours.'
  - title: Construction
    videoPrefix: Construction
    icon: {fileID: 21300000, guid: 3763e4295dfd486cafa11f69f5bfeda7, type: 3}
    windows:
    - title: "Ouvrir les caisses de l'ing\xE9nieur"
      text: "Pendant les vagues, des caisses de l'ing\xE9nieur tombent dans la jungle,
        sous un rayon violet. Vise-en une et appuie sur la g\xE2chette (ou la g\xE2chette
        de prise) : choisis un lot de plans de construction."
    - title: "Choisir un b\xE2timent"
      text: "Touche le bouton \xAB Plans \xBB de ta montre avec l'autre main : le
        menu des plans s'ouvre, et l'hologramme du b\xE2timent du milieu suit le
        rayon de ta main, sur la grille au sol : verte o\xF9 il se pose, rouge ailleurs.
        Joystick : gauche et droite changent de b\xE2timent (ou touche une carte),
        haut et bas le tournent ; g\xE2chette : poser ; poign\xE9e : fermer. Sur
        un b\xE2timent pareil, il monte de niveau ; entre les vagues, son panneau
        propose de le d\xE9placer."
    - title: Construire
      text: "Un marteau appara\xEEt dans chaque main. Frappe trois fois le plan bleu
        pour construire le b\xE2timent."
